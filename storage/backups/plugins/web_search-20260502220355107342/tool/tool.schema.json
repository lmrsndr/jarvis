{
  "tool_name": "web_search",
  "version": "0.7.0",
  "description": "Strict trusted-source web lookup with real weather, BBC and Guardian football extraction, RSS news, teachable source categories, caching, summarised answers, and source-agreement confidence scoring.",
  "entry_file": "tool.py",
  "entry_function": "run",
  "permissions": "safe",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {"type": "string", "description": "Search query or question."},
      "max_results": {"type": "integer", "default": 5, "minimum": 1, "maximum": 12},
      "action": {"type": "string", "enum": ["search", "add_source_category", "list_source_categories", "remove_source_category", "clear_cache"], "default": "search"},
      "category": {"type": "string", "description": "Source category name for teachable source actions."},
      "description": {"type": "string"},
      "sources": {"type": "array", "items": {"type": "string"}},
      "rss": {"type": "array", "items": {"type": "string"}},
      "keywords": {"type": "array", "items": {"type": "string"}},
      "location": {"type": "string", "description": "Optional location for weather queries."},
      "no_cache": {"type": "boolean", "default": false}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "query": {"type": "string"},
      "handler": {"type": "string"},
      "answer": {"type": "string"},
      "confidence": {"type": "number"},
      "confidence_label": {"type": "string"},
      "results": {"type": "array"},
      "sources": {"type": "array"},
      "error": {"type": "string"},
      "teach_request": {"type": "boolean"},
      "suggested_action": {"type": "object"}
    }
  }
}
