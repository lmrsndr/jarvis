[
  {
    "id": "bundlebee",
    "name": "Bundlebee",
    "version": "1.0.0",
    "description": "Operate the owner's Bundlebee workflow through a locally configured adapter.",
    "transport": "http",
    "endpoint": "http://127.0.0.1:8091/jarvis/run",
    "token_env": "BUNDLEBEE_ADAPTER_TOKEN",
    "input_schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": ["link_validation", "price_check", "regular"]
        },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "dry_run": { "type": "boolean" }
      },
      "required": ["task", "max_items", "dry_run"],
      "additionalProperties": false
    },
    "resources": ["cpu"],
    "risk": "approval",
    "idempotent": false,
    "supports_checkpoint": true,
    "timeout_seconds": 3600,
    "success_schema": {
      "type": "object",
      "properties": { "ok": { "const": true }, "verified": { "const": true } },
      "required": ["ok", "verified"]
    }
  },
  {
    "id": "postgamelens",
    "name": "PostGameLens Studio",
    "version": "1.0.0",
    "description": "Request stitching, rendering or tactical analysis from the owner's Studio adapter.",
    "transport": "http",
    "endpoint": "http://127.0.0.1:8092/jarvis/run",
    "token_env": "POSTGAMELENS_ADAPTER_TOKEN",
    "input_schema": {
      "type": "object",
      "properties": {
        "match_id": { "type": "string" },
        "stage": {
          "type": "string",
          "enum": ["stitch", "render", "tactical_analysis"]
        }
      },
      "required": ["match_id", "stage"],
      "additionalProperties": false
    },
    "resources": ["video_gpu"],
    "risk": "approval",
    "idempotent": false,
    "supports_checkpoint": true,
    "timeout_seconds": 86400,
    "success_schema": {
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "output_valid": { "const": true },
        "artifacts": { "type": "array", "minItems": 1 }
      },
      "required": ["ok", "output_valid", "artifacts"]
    }
  }
]
