JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

JARVIS_ADMIN_PASSWORD_HASH=
JARVIS_LOCAL_ONLY=true
JARVIS_ALLOW_REMOTE=false
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

JARVIS_MEMORY_DB_PATH=./storage/jarvis.db
JARVIS_VECTOR_PATH=./storage/memory_files/vectors.json

JARVIS_STT_PROVIDER=local
JARVIS_STT_MODEL=base

# Explicitly configured outbound owner reports. Secrets stay here, never in skills.
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_EMAIL_FROM=
JARVIS_EMAIL_TO=

# Optional quiet hours in Europe/London; blank means reports send when due.
JARVIS_EMAIL_QUIET_START=
JARVIS_EMAIL_QUIET_END=

# Bundlebee public API origin including /api. Used only after owner skill installation.
BUNDLEBEE_API_BASE=
